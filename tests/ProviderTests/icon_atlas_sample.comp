#version 450
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D atlas;
layout(std430, set = 0, binding = 1) buffer Samples {
    vec4 rgba;
    vec4 overWhite;
} outputSamples;
layout(push_constant) uniform Coordinates { uvec2 pixel; } coordinates;
void main() {
    vec4 color = texelFetch(atlas, ivec2(coordinates.pixel), 0);
    outputSamples.rgba = color;
    outputSamples.overWhite = vec4(color.rgb * color.a + vec3(1.0) * (1.0 - color.a), 1.0);
}
