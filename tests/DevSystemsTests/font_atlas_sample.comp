#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D preview_page;
layout(set = 0, binding = 1) uniform sampler2DArray font_atlas;
layout(std430, set = 0, binding = 2) buffer Samples {
    uint pixels[3];
} samples;

void main() {
    samples.pixels[0] = packUnorm4x8(texelFetch(preview_page, ivec2(0), 0));
    samples.pixels[1] = packUnorm4x8(texelFetch(font_atlas, ivec3(0, 0, 0), 0));
    samples.pixels[2] = packUnorm4x8(texelFetch(font_atlas, ivec3(0, 0, 1), 0));
}
