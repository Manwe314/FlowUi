@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(_flowui_package_prefix "${PACKAGE_PREFIX_DIR}")

find_dependency(Vulkan)
@FLOWUI_PLATFORM_PACKAGE_REQUIREMENTS@
@FLOWUI_STORAGE_PACKAGE_REQUIREMENTS@
@FLOWUI_CONTENT_PACKAGE_REQUIREMENTS@
if(@FLOW_UI_AGENTIC_WORKFLOW_VALUE@)
    find_dependency(Threads)
endif()
if(@FLOWUI_NEEDS_DEFAULT_ICON@)
    find_dependency(plutosvg)
endif()
set(FlowUi_FontBaking_FOUND @FLOWUI_CONFIG_DEFAULT_FONT_BAKING@)
if(@FLOWUI_CONFIG_DEFAULT_FONT_BAKING@ AND (@FLOWUI_ENABLE_RUNTIME_FONT_BAKING@ OR "FontBaking" IN_LIST FlowUi_FIND_COMPONENTS))
    find_dependency(msdf-atlas-gen CONFIG)
endif()

set(FLOWUI_PUBLIC_VULKAN_INTEROP @FLOWUI_PUBLIC_VULKAN_INTEROP_VALUE@)
set(FLOWUI_INCLUDE_ICON_MANAGER @FLOWUI_INCLUDE_ICON_MANAGER_VALUE@)
set(FLOW_UI_AGENTIC_WORKFLOW @FLOW_UI_AGENTIC_WORKFLOW_VALUE@)

include("${CMAKE_CURRENT_LIST_DIR}/FlowUiTargets.cmake")
if(@FLOWUI_CONFIG_DEFAULT_FONT_BAKING@ AND NOT @FLOWUI_ENABLE_RUNTIME_FONT_BAKING@ AND "FontBaking" IN_LIST FlowUi_FIND_COMPONENTS)
    include("${CMAKE_CURRENT_LIST_DIR}/FlowUiFontBakingTargets.cmake")
endif()
set(PACKAGE_PREFIX_DIR "${_flowui_package_prefix}")
set(FLOWUI_RESOURCE_SUBDIRECTORY "@FLOWUI_RESOURCE_SUBDIRECTORY@")
set_property(TARGET FlowUi::FlowUi PROPERTY FLOWUI_RESOURCE_DIRECTORY
    "@PACKAGE_FLOWUI_INSTALL_RESOURCE_DIRECTORY@")
include("${CMAKE_CURRENT_LIST_DIR}/FlowUiResources.cmake")

check_required_components(FlowUi)
