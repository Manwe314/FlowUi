file(REAL_PATH "${SOURCE_DIRECTORY}" source_directory)
file(MAKE_DIRECTORY "${DESTINATION_DIRECTORY}")
file(REAL_PATH "${DESTINATION_DIRECTORY}" destination_directory)
if(NOT source_directory STREQUAL destination_directory)
    file(COPY "${SOURCE_DIRECTORY}/" DESTINATION "${DESTINATION_DIRECTORY}")
endif()
if(EXTRA_DIRECTORY)
    file(COPY "${EXTRA_DIRECTORY}/" DESTINATION "${DESTINATION_DIRECTORY}")
endif()
