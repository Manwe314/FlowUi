include_guard(GLOBAL)

# Register a source-build CPU provider before add_subdirectory(FlowUi).
# TARGETS carry include usage requirements; PACKAGES name relocatable dependencies.
function(flowui_register_content_provider)
    cmake_parse_arguments(PARSE_ARGV 0 provider "" "DOMAIN" "SOURCES;TARGETS;PACKAGES")
    if(provider_UNPARSED_ARGUMENTS OR NOT provider_DOMAIN MATCHES "^(TEXT_LAYOUT|FONT_MSDF|ICON_RASTER)$")
        message(FATAL_ERROR "Content provider requires DOMAIN TEXT_LAYOUT, FONT_MSDF, or ICON_RASTER and SOURCES/TARGETS/PACKAGES.")
    endif()
    foreach(package IN LISTS provider_PACKAGES)
        if(NOT package MATCHES "^[A-Za-z0-9_.+-]+$")
            message(FATAL_ERROR "Content provider PACKAGES must contain package names: ${package}")
        endif()
    endforeach()
    foreach(source IN LISTS provider_SOURCES)
        get_filename_component(absolute_source "${source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        set_property(GLOBAL APPEND PROPERTY FLOWUI_${provider_DOMAIN}_PROVIDER_SOURCES "${absolute_source}")
    endforeach()
    set_property(GLOBAL APPEND PROPERTY FLOWUI_${provider_DOMAIN}_PROVIDER_TARGETS ${provider_TARGETS})
    set_property(GLOBAL APPEND PROPERTY FLOWUI_${provider_DOMAIN}_PROVIDER_PACKAGES ${provider_PACKAGES})
endfunction()

function(flowui_add_content_module target domain)
    get_property(provider_sources GLOBAL PROPERTY FLOWUI_${domain}_PROVIDER_SOURCES)
    get_property(provider_targets GLOBAL PROPERTY FLOWUI_${domain}_PROVIDER_TARGETS)
    if(NOT FLOWUI_CONFIG_CUSTOM_${domain}_PROVIDER)
        set(provider_sources ${ARGN})
        set(provider_targets "")
    endif()
    foreach(dependency IN LISTS provider_targets)
        if(NOT TARGET ${dependency})
            message(FATAL_ERROR "Registered ${domain} provider dependency target does not exist: ${dependency}")
        endif()
    endforeach()
    if(provider_sources)
        add_library(${target} STATIC ${provider_sources})
        set_target_properties(${target} PROPERTIES POSITION_INDEPENDENT_CODE ON)
        target_compile_features(${target} PUBLIC cxx_std_23)
        target_include_directories(${target} PRIVATE "${FLOWUI_GENERATED_INCLUDE_DIR}" "${PROJECT_SOURCE_DIR}/include" "${PROJECT_SOURCE_DIR}/external")
        target_link_libraries(${target} PRIVATE ${provider_targets})
    else()
        add_library(${target} INTERFACE)
        target_link_libraries(${target} INTERFACE ${provider_targets})
    endif()
    set_property(GLOBAL APPEND PROPERTY FLOWUI_CONTENT_PROVIDER_MODULES ${target})
endfunction()
