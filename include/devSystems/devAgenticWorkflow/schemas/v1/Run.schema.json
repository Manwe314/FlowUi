{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowui.dev/schemas/agentic/v1/Run.schema.json",
  "title": "FlowUi.Agentic.Run",
  "type": "object",
  "properties": {
    "schema": {
      "const": "FlowUi.Agentic.Run"
    },
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "monotonic_anchor_ns": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20,
      "description": "Unsigned 64-bit decimal; the codec rejects values above 18446744073709551615."
    }
  },
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "created_at_utc",
    "monotonic_anchor_ns"
  ],
  "additionalProperties": true
}
