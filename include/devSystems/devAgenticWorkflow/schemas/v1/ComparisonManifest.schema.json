{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowui.dev/schemas/agentic/v1/ComparisonManifest.schema.json",
  "title": "FlowUi.Agentic.ComparisonManifest",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "comparison_id",
    "baseline_manifest_sha256",
    "candidate_manifest_sha256",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "FlowUi.Agentic.ComparisonManifest"
    },
    "schema_version": {
      "const": "1.0"
    },
    "comparison_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "baseline_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "enum": [
              "comparison.json",
              "summary.md"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$",
            "maxLength": 20
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
