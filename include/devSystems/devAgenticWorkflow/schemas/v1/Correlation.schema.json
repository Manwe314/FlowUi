          "maxLength": 20,
          "description": "Unsigned 64-bit decimal; the codec rejects values above 18446744073709551615."
        },
        "record_sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20,
          "description": "Unsigned 64-bit decimal; the codec rejects values above 18446744073709551615."
        },
        "invocation_id": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20,
