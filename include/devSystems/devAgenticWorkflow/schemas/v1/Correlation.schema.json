  "$id": "https://flowui.dev/schemas/agentic/v1/Correlation.schema.json",
  "title": "FlowUi.Agentic.Correlation",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "source",
    "target",
    "relationship",
    "method",
    "confidence",
    "resolution"
  ],
  "properties": {
    "schema": {
      "const": "FlowUi.Agentic.Correlation"
    },
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "capture_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$",
      "not": {
        "enum": [
          ".",
