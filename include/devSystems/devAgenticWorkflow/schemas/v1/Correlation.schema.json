    "method": {
      "enum": [
        "explicit_identity",
        "shared_context",
        "temporal_proximity",
        "unresolved"
      ]
    },
    "confidence": {
      "enum": [
        "explicit",
        "high",
        "medium",
        "low",
        "candidate",
        "unknown",
        "none",
        "shared_context",
        "temporal_nearby"
      ]
    },
    "resolution": {
      "enum": [
        "resolved",
        "candidate",
        "disabled",
        "unsupported",
        "not_requested",
        "outside_capture",
        "evicted",
        "truncated",
        "pending_at_timeout",
        "unavailable",
        "failed",
        "unresolved",
        "not_retained",
