{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowui.dev/schemas/agentic/v1/Session.schema.json",
  "title": "FlowUi.Agentic.Session",
  "type": "object",
  "properties": {
    "schema": {
      "const": "FlowUi.Agentic.Session"
    },
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "status": {
      "enum": [
        "running",
        "stopped"
      ]
    },
    "last_app_tick": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20,
      "description": "Unsigned 64-bit decimal; the codec rejects values above 18446744073709551615."
    },
    "last_safe_point_ns": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20,
      "description": "Unsigned 64-bit decimal; the codec rejects values above 18446744073709551615."
    }
  },
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "status",
    "last_app_tick"
  ],
  "additionalProperties": false
}
