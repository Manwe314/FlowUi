{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowui.dev/schemas/agentic/v1/BuildDiagnostics.schema.json",
  "title": "FlowUi.Agentic.BuildDiagnostics",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "domain",
    "producer",
    "build_id",
    "parser",
    "diagnostics",
    "raw_log_bytes",
    "unparsed_lines",
    "coverage"
  ],
  "properties": {
    "schema": {
      "const": "FlowUi.Agentic.BuildDiagnostics"
    },
    "schema_version": {
      "const": "1.0"
    },
    "domain": {
      "const": "build"
    },
    "producer": {
      "type": "string"
    },
    "build_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "parser": {
      "type": "string"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "domain",
          "severity",
          "location",
          "message",
          "normalization_confidence",
          "raw_log"
        ],
        "properties": {
          "domain": {
            "const": "build"
          },
          "severity": {
            "enum": [
              "fatal",
              "error",
              "warning",
              "note"
            ]
          },
          "location": {
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "raw_log": {
            "type": "object"
          },
          "related_notes": {
            "type": "array"
          }
        }
      }
    },
    "raw_log_bytes": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20,
      "description": "Unsigned 64-bit decimal; the codec rejects values above 18446744073709551615."
    },
    "unparsed_lines": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20,
      "description": "Unsigned 64-bit decimal; the codec rejects values above 18446744073709551615."
    },
    "coverage": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
