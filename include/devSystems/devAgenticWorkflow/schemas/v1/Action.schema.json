{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowui.dev/schemas/agentic/v1/Action.schema.json",
  "title": "FlowUi.Agentic.Action",
  "type": "object",
  "properties": {
    "schema": {
      "const": "FlowUi.Agentic.Action"
    },
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "capture_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "phase": {
      "enum": [
        "setup_readiness",
        "measured_startup_setup",
        "measured_step",
        "assertions",
        "cleanup"
      ]
    },
    "app_tick": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20
    },
    "monotonic_ns": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "target": {
      "type": "string",
      "maxLength": 512
    },
    "arguments": {},
    "assertion": {
      "type": "boolean"
    },
    "passed": {
      "type": "boolean"
    },
    "state_revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20
    },
    "observed_frame": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$",
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        },
        "app_tick": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        },
        "window_id": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        },
        "window_frame": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        }
      },
      "required": [
        "run_id",
        "app_tick",
        "window_id",
        "window_frame"
      ],
      "additionalProperties": false
    },
    "duration_ns": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20
    },
    "result": {
      "enum": [
        "complete",
        "pending",
        "failed"
      ]
    }
  },
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "capture_id",
    "job_id",
    "scenario_id",
    "phase",
    "app_tick",
    "monotonic_ns"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "action",
        "target",
        "arguments",
        "assertion",
        "passed"
      ]
    },
    {
      "required": [
        "duration_ns",
        "result"
      ]
    }
  ]
}
