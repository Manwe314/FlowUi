{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowui.dev/schemas/agentic/v1/Scenario.schema.json",
  "title": "FlowUi.Agentic.Scenario",
  "type": "object",
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "minLength": 1
    },
    "fixture_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "offline",
        "cpu_scenario",
        "layout_scenario",
        "offscreen_vulkan",
        "windowed"
      ]
    },
    "seed": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20,
      "description": "Unsigned 64-bit decimal; the codec rejects values above 18446744073709551615."
    },
    "deadline_ns": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20,
      "description": "Unsigned 64-bit decimal; the codec rejects values above 18446744073709551615."
    },
    "deterministic": {
      "type": "boolean"
    },
    "replayable": {
      "type": "boolean"
    },
    "mutating": {
      "type": "boolean"
    },
    "external_services": {
      "type": "boolean"
    },
    "surfaces": {
      "type": "array",
      "items": {}
    },
    "assertions": {
      "type": "array",
      "items": {}
    }
  },
  "required": [
    "scenario_id",
    "revision",
    "digest",
    "fixture_id",
    "description",
    "mode",
    "seed",
    "deadline_ns",
    "deterministic",
    "replayable",
    "mutating",
    "external_services",
    "surfaces",
    "assertions"
  ],
  "additionalProperties": false
}
